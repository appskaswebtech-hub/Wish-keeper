{% comment %}
  Wishlist Custom Button Connector — App Embed Block
  Wires up existing theme markup like:
    <button class="st-wishlist-button" data-handle="{{ product.handle }}">Add to Wishlist</button>
  without requiring any theme code edits beyond enabling this app embed once.
{% endcomment %}

<script>
  window.__wlCustomBtnConfig = {
    shop: {{ shop.permanent_domain | json }},
    proxyUrl: {{ shop.url | json }} + "/apps/wishlist",
    customerId: {{ customer.id | json }},
    selector: {{ block.settings.selector | json }}
  };
</script>
<script src="{{ 'wishlist-custom-button.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Wishlist Btn Connector",
  "target": "body",
  "settings": []
}
{% endschema %}
