generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
  enabledApiClients   String?
}

model Store {
  id            String         @id @default(uuid())
  shop          String         @unique
  installedAt   DateTime       @default(now())
  uninstalledAt DateTime?
  isActive      Boolean        @default(true)
  wishlists     Wishlist[]
  settings      StoreSettings?
  productWatch  ProductWatch[]
  alerts        WishlistAlert[]
}

model StoreSettings {
  id                String  @id @default(uuid())
  storeId           String  @unique
  store             Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
   language          String?
  showShareButton   Boolean @default(true)
  showItemCount     Boolean @default(true)
  maxItemsPerList   Int     @default(50)
  showTitle         Boolean @default(true)
  showPrice         Boolean @default(true)
  showAddToCart     Boolean @default(true)
  showVendor        Boolean @default(false)
  gridColumns       Int     @default(4)
  iconStyle         String  @default("heart")
  activeColor       String  @default("#e74c6f")
  headerIconEnabled Boolean @default(true)
  storefrontToken   String?
   customCss         String? @db.Text
   loadingIcon       String  @default("ring")
  notAddedIcon      String  @default("heart-outline")
  addedIcon         String  @default("heart-filled")
  loadingIconColor  String  @default("#6b7280")
  customIconSvg     String? @db.Text
  customIconColor   String  @default("#e74c6f")

  // The product-page "Add to Wishlist" button: show the icon with custom
  // wording, or icon only. When icon-only, buttonIconPosition controls
  // which side of the button's own space the icon sits on. Replaces the old
  // per-block "Button style" theme editor setting, now controlled here.
  buttonDisplayMode  String @default("text")
  buttonText         String @default("Add to Wishlist")
  buttonIconPosition String @default("left")

  wishlistDisplayMode String @default("page")

  customWishlistButtonHtml String? @db.Text

  alertsEnabled     Boolean @default(false)
  lowStockThreshold Int     @default(5)
  smtpHost          String?
  smtpPort          Int?
  smtpUser          String?
  smtpPassword      String?
  smtpFromEmail     String?
  smtpFromName      String?
}

model Wishlist {
  id         String             @id @default(uuid())
  storeId    String
  store      Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerId String
  name       String             @default("My Wishlist")
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  items      WishlistItem[]
  activities WishlistActivity[]

  @@unique([storeId, customerId, name])
  @@index([storeId, customerId])
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  variantId  String?
  addedAt    DateTime @default(now())

  @@unique([wishlistId, productId, variantId])
  @@index([wishlistId])
}

model WishlistActivity {
  id         String   @id @default(uuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  variantId  String?
  action     String
  createdAt  DateTime @default(now())

  @@index([wishlistId])
}

model ProductWatch {
  id            String   @id @default(uuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId     String
  lastPrice     Float?
  lastInventory Int?
  updatedAt     DateTime @updatedAt

  @@unique([storeId, productId])
}

model WishlistAlert {
  id         String   @id @default(uuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId  String
  customerId String
  type       String
  sentAt     DateTime @default(now())

  @@index([storeId, productId])
}

model ShopPlan {
  id               Int       @id @default(autoincrement())
  shop             String    @unique
  plan             String    @default("free")
  subscriptionId   String?
  status           String    @default("active")
  trialEndsAt      DateTime?
  billingStartedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([shop])
}

// One support chat thread per shop, between the merchant (inside the embedded
// app widget) and WishKeeper's team (via the future admin dashboard).
model SupportThread {
  id               String           @id @default(uuid())
  shop             String           @unique
  shopUnreadCount  Int              @default(0)
  adminUnreadCount Int              @default(0)
  // Last time each side actually opened/viewed this thread -- used to show
  // a "Seen" receipt under the admin's most recent message.
  shopLastReadAt   DateTime?
  adminLastReadAt  DateTime?
  // Set when an admin closes the conversation from the dashboard; cleared
  // the next time the merchant sends a message (auto-reopen).
  closedAt         DateTime?
  // Set by the Chat Agent backend whenever an admin types in the dashboard;
  // the widget treats it as "typing" for a few seconds after this timestamp
  // since there's no live push channel to clear it explicitly.
  adminTypingAt    DateTime?
  // Set when the merchant clicks "Start new chat" after a closed thread.
  // Older messages stay in the database (the admin dashboard always shows
  // full history) but are hidden from the merchant's own widget from this
  // point on, so it reads like a genuinely fresh conversation.
  lastResetAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  messages         SupportMessage[]

  @@index([shop])
}

model SupportMessage {
  id             String        @id @default(uuid())
  threadId       String
  thread         SupportThread @relation(fields: [threadId], references: [id])
  sender         String // "shop" | "admin"
  body           String?       @db.Text
  attachmentUrl  String?
  attachmentName String?
  attachmentType String?
  attachmentSize Int?
  createdAt      DateTime      @default(now())

  @@index([threadId, createdAt])
}